# Variabile de mediu — DOAR pe server. Niciun secret cu prefix NEXT_PUBLIC_.

# Cheia Anthropic pentru evaluare și analiza AI a deal-urilor. Obligatorie.
ANTHROPIC_API_KEY=

# Serviciu de scraping (opțional). Fără el, se face fetch direct spre Autovit
# și anti-bot-ul (DataDome) blochează de obicei cererile din serverless.
# Cu el, cererile trec prin serviciu (ScraperAPI / Zyte etc.).
SCRAPER_API_KEY=
# Endpoint-ul serviciului (implicit ScraperAPI).
SCRAPER_API_ENDPOINT=https://api.scraperapi.com
# Randare JS: "0" o oprește (implicit pornită).
SCRAPER_RENDER=1
